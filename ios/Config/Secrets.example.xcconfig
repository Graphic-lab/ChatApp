// Copy to Secrets.xcconfig (git-ignored) and fill in.
// The "//" in URLs must be escaped in xcconfig: use $()/ as shown.
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-OR-PUBLISHABLE-KEY
DEVELOPMENT_TEAM = YOUR-APPLE-TEAM-ID
// Optional: change if the bundle id is taken in your Apple account
// APP_BUNDLE_ID = com.example.hearttoheart
